# Backend Configuration for Portul Hypercompiler

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Redis (para compilación en queue)
REDIS_URL=redis://127.0.0.1:6379

# Storage
STORAGE_DIR=./builds

# LLVM
LLVM_PATH=/usr/bin
LLVM_VERSION=17

# Logging
LOG_LEVEL=debug

# Build options
BUILD_TIMEOUT=120000
MAX_BUILD_SIZE=50000000
