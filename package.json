{
  "name": "portul-hypercompiler",
  "description": "PortulTro - Portul IDE offline compiler suite",
  "author": "alexisgeneral15",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/portultro/main.cjs",
  "scripts": {
    "dev": "vite",
    "start:dev": "node scripts/dev-electron.cjs",
    "build": "vite build && node scripts/postbuild-fix-css.cjs",
    "rebuild": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:native": "pkg portul-compiler.cjs --targets node18-win-x64 --output PortulCompiler.exe --compress Brotli",
    "bootstrap:exe": "node bootstrap-exe.cjs",
    "build:desktop": "node scripts/build-desktop.cjs",
    "build:desktop:dir": "node scripts/build-desktop-dir.cjs",
    "build:portulc": "node build-portulc.mjs",
    "build:portulrt": "node build-portulrt.mjs",
    "portulc": "node portulc.cjs",
    "portulrt": "node portulrt.cjs",
    "build:portultro-core": "vite build --mode production && node portultro-core/build-portultro-core.cjs",
    "build:all": "pkg . --targets node18-win-x64,node18-macos-x64,node18-linux-x64 --compress Brotli",
    "compile": "node portul-compiler.cjs",
    "start": "npm run build && electron electron/portultro/main.cjs",
    "start:electron": "electron electron/portultro/main.cjs",
    "start:backend": "node backend/src/index.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:web": "vite"
  },
  "bin": {
    "portul": "portul-compiler.cjs",
    "PortulCompiler": "portul-compiler.cjs"
  },
  "pkg": {
    "scripts": [
      "backend/**/*.js",
      "src/**/*.js"
    ],
    "assets": [
      "backend/",
      "src/"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "./",
    "compress": "Brotli"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jszip": "3.10.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "electron": "^32.2.2",
    "electron-builder": "^24.13.3",
    "pkg": "^5.8.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.portul.portultro",
    "productName": "PortulTro",
    "directories": {
      "output": "dist-desktop"
    },
    "icon": "electron/portultro/Nuevo Lienzo.ico",
    "files": [
      "dist/**",
      "backend/**/*",
      "backend/package.json",
      "backend/src/**/*",
      "electron/portultro/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "PortulTro-${version}.exe",
      "icon": "electron/portultro/Nuevo Lienzo.ico",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "afterSign": "electron/portultro/sign-installer.cjs"
  }
}